{
  "name": "Wan Image API",
  "description": "Vector Engine Wan 图像生成 API - wan2.7-image-pro",
  "endpoints": {
    "draw": "/v1/images/generations"
  },
  "hosts": {
    "china": "https://api.vectorengine.ai",
    "overseas": "https://api.vectorengine.ai"
  },
  "default_host": "china",
  "request_format": {
    "draw": {
      "method": "POST",
      "headers": {
        "Authorization": "Bearer {api_key}",
        "Content-Type": "application/json"
      },
      "body": {
        "model": "wan2.7-image-pro",
        "prompt": "{prompt}",
        "size": "{image_size}",
        "n": 1,
        "watermark": false,
        "prompt_extend": false
      }
    }
  },
  "response_format": {
    "draw": {
      "image_url_path": "data[0].url",
      "b64_json_path": "data[0].b64_json",
      "success_indicator": "data"
    }
  },
  "models": [
    "wan2.7-image-pro"
  ],
  "image_sizes": ["1024x1024", "1024x1792", "1792x1024", "512x512"],
  "aspect_ratios": ["1:1", "9:16", "16:9"]
}
