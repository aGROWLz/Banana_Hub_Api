{
  "name": "KK Seedream API",
  "description": "KK 中转站 Seedream 图像生成 API - doubao-seedream-4.0/4.5/3.0",
  "endpoints": {
    "draw": "/v1/images/generations"
  },
  "hosts": {
    "china": "https://ai-api.kkidc.com",
    "overseas": "https://ai-api.kkidc.com",
    "custom": "https://ai-api.kkidc.com"
  },
  "default_host": "china",
  "request_format": {
    "draw": {
      "method": "POST",
      "headers": {
        "Authorization": "Bearer {api_key}",
        "Content-Type": "application/json"
      },
      "body": {
        "model": "{model}",
        "prompt": "{prompt}",
        "size": "{size}",
        "n": "{n}",
        "seed": "{seed}",
        "response_format": "url",
        "watermark": false
      }
    }
  },
  "response_format": {
    "draw": {
      "image_url_path": "data[0].url",
      "b64_json_path": "data[0].b64_json",
      "success_indicator": "data"
    }
  },
  "models": [
    "doubao-seedream-4.5",
    "doubao-seedream-4-0-250828",
    "doubao-seedream-3.0-t2i",
    "doubao-seededit-3.0-i2i"
  ],
  "image_sizes": [
    "1024x1024",
    "1664x936",
    "936x1664",
    "2048x2048",
    "1K",
    "2K",
    "4K"
  ],
  "aspect_ratios": ["1:1", "16:9", "9:16"]
}
