{
  "name": "XKU GPT-Image-2 API",
  "description": "XKU GPT-Image-2 edit API with behavior-focused parameters.",
  "gpt_image2_mode": "official",
  "endpoints": {
    "draw": "/v1/images/generations",
    "edit": "/v1/images/edits"
  },
  "hosts": {
    "china": "https://api-ai.xku.com",
    "overseas": "https://api-ai.xku.com",
    "custom": "https://api-ai.xku.com"
  },
  "default_host": "china",
  "request_format": {
    "draw": {
      "method": "POST",
      "content_type": "application/json",
      "headers": {
        "Authorization": "Bearer {api_key}",
        "Accept": "application/json"
      },
      "body": {
        "model": "{model}",
        "prompt": "{prompt}",
        "n": "{n}",
        "size": "{size}",
        "quality": "{quality}",
        "moderation": "{moderation}",
        "user": "{user}"
      }
    },
    "edit": {
      "method": "POST",
      "content_type": "multipart/form-data",
      "headers": {
        "Authorization": "Bearer {api_key}",
        "Accept": "application/json"
      },
      "body": {
        "model": "{model}",
        "prompt": "{prompt}",
        "n": "{n}",
        "size": "{size}",
        "quality": "{quality}",
        "moderation": "{moderation}",
        "user": "{user}"
      },
      "files": {
        "mask": {
          "field": "mask",
          "required": false,
          "description": "遮罩图像，一个 PNG 文件，完全透明的区域为将被编辑的位置，小于 4MB，尺寸与 image 一致"
        }
      }
    }
  },
  "response_format": {
    "draw": {
      "image_url_path": "data[0].url",
      "b64_json_path": "data[0].b64_json",
      "success_indicator": "data"
    }
  },
  "models": [
    "gpt-image-2"
  ],
  "model_mapping": {},
  "image_sizes": [
    "auto",
    "1024x1024",
    "1536x1024",
    "1024x1536",
    "2048x2048",
    "2048x1152",
    "3840x2160",
    "2160x3840"
  ],
  "aspect_ratios": []
}
