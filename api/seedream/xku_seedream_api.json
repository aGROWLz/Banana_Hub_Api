{
  "name": "XKU Seedream API",
  "description": "XKU 中转站 Doubao Seedream 图像生成 API（兼容火山方舟格式）",
  "endpoints": {
    "draw": "/doubao/v3/images/generations"
  },
  "hosts": {
    "china": "https://api-ai.xku.com",
    "overseas": "https://api-ai.xku.com",
    "custom": "https://api-ai.xku.com"
  },
  "default_host": "china",
  "request_format": {
    "draw": {
      "method": "POST",
      "headers": {
        "Authorization": "Bearer {api_key}",
        "Content-Type": "application/json"
      },
      "body": {
        "model": "{model}",
        "prompt": "{prompt}",
        "size": "{size}",
        "seed": "{seed}",
        "response_format": "url",
        "output_format": "png",
        "watermark": false
      }
    }
  },
  "response_format": {
    "draw": {
      "image_url_path": "data[0].url",
      "b64_json_path": "data[0].b64_json",
      "success_indicator": "data"
    }
  },
  "models": [
    "doubao-seedream-5-0-pro-260628",
    "doubao-seedream-5-0-260128"
  ],
  "image_sizes": [
    "1K",
    "1.5K",
    "2K",
    "3K",
    "4K"
  ],
  "aspect_ratios": ["1:1", "16:9", "9:16"]
}
