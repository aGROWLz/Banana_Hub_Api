{
  "name": "火山方舟 Seedream API",
  "description": "火山方舟官方 Doubao Seedream 图像生成 API（https://console.volcengine.com/ark）",
  "endpoints": {
    "draw": "/api/v3/images/generations"
  },
  "hosts": {
    "china": "https://ark.cn-beijing.volces.com",
    "overseas": "https://ark.ap-southeast-1.volces.com",
    "custom": "https://ark.cn-beijing.volces.com"
  },
  "default_host": "china",
  "request_format": {
    "draw": {
      "method": "POST",
      "headers": {
        "Authorization": "Bearer {api_key}",
        "Content-Type": "application/json"
      },
      "body": {
        "model": "{model}",
        "prompt": "{prompt}",
        "size": "{size}",
        "seed": "{seed}",
        "response_format": "url",
        "output_format": "png",
        "watermark": false
      }
    }
  },
  "response_format": {
    "draw": {
      "image_url_path": "data[0].url",
      "b64_json_path": "data[0].b64_json",
      "success_indicator": "data"
    }
  },
  "models": [
    "doubao-seedream-5-0-pro-260628",
    "doubao-seedream-5-0-260128",
    "doubao-seedream-4-5-251128",
    "doubao-seedream-4-0-250828"
  ],
  "image_sizes": [
    "1K",
    "1.5K",
    "2K",
    "3K",
    "4K"
  ],
  "aspect_ratios": ["1:1", "16:9", "9:16"]
}
